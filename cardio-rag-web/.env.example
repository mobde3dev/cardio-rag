# CardioRAG Web Environment Variables

# Groq API Key for Vercel / Production Environment Settings
GROQ_API_KEY=your_groq_api_key_here

# Default Model Selection
DEFAULT_GROQ_MODEL=openai/gpt-oss-120b
DEFAULT_TRANSLATION_MODEL=openai/gpt-oss-20b

# Embeddings & Vector Search Backend URL (e.g. Render FastAPI URL or local backend)
RAG_BACKEND_URL=http://127.0.0.1:8000
